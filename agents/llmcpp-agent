#!/usr/bin/env python3
"""llmcpp-agent: the reference LLM agent for llmc++.

llmc++ starts this program and talks newline-delimited JSON-RPC over its
stdin/stdout. The agent is an MCP client of llmc++: while answering an
`llm/generate` request for an __llm__ function it calls llmc++'s tools
(get_task, lookup, try_compile, submit, ...). The body arrives via `submit`.

Backends (LLMCPP_BACKEND):
  anthropic    The Claude Messages API. Needs ANTHROPIC_API_KEY.
  openai       The OpenAI Responses API. Needs OPENAI_API_KEY.
  codex        `codex exec` with llmc++'s tools as an MCP server.
               Uses your Codex login.
  claude       `claude -p` (Claude Code) with llmc++'s tools as an MCP server.
               Uses your Claude Code login.

Environment:
  LLMCPP_MODEL    Model id or alias (anthropic default: claude-opus-5;
                  CLI backends otherwise use their own default model).
  LLMCPP_EFFORT   Effort level for Codex or Claude Code (default: medium).
  LLMCPP_CODEX    The codex executable (default: codex).
  LLMCPP_CLAUDE   The claude executable (default: claude).
  LLMCPP_VERBOSE  Set by `llmc++ -fllm-verbose`; logs progress to stderr.
"""

import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

VERSION = "0.1-prototype"
VERBOSE = bool(os.environ.get("LLMCPP_VERBOSE"))


# Write agent progress to the diagnostic stream.
def log(*args):
    if VERBOSE:
        print("llmcpp-agent:", *args, file=sys.stderr, flush=True)


# Describe the generation task and its effective settings to the model.
def task_message(task):
    return (
        "Generate the body of the __llm__ function `%s` (%s).\n"
        "Start with get_task. Use the other tools as needed, check the code "
        "with try_compile, then call submit with the final body."
        % (task.get("name", "?"), task.get("location", "?"))
        + "\nEffective settings: " + json.dumps(task.get("generation", {}))
    )


class Connection:
    """JSON-RPC with llmc++ over stdin/stdout."""

    # Initialize the compiler transport and pending request state.
    def __init__(self):
        self._in = sys.stdin.buffer
        self._out = sys.stdout.buffer
        self._lock = threading.Lock()
        self._next_id = 1
        self._pending = []

    # Send one JSON-RPC message to the compiler.
    def send(self, message):
        self._out.write((json.dumps(message) + "\n").encode())
        self._out.flush()

    # Read one compiler message or report end of input.
    def _read(self):
        line = self._in.readline()
        return json.loads(line) if line else None

    # Consume deferred messages before reading more compiler input.
    def next_message(self):
        return self._pending.pop(0) if self._pending else self._read()

    # Serialize requests and defer unrelated messages until the reply arrives.
    def request(self, method, params):
        with self._lock:
            request_id = "agent-%d" % self._next_id
            self._next_id += 1
            self.send({
                "jsonrpc": "2.0",
                "id": request_id,
                "method": method,
                "params": params,
            })
            while True:
                message = self._read()
                if message is None:
                    raise EOFError("llmc++ closed the connection")
                if message.get("id") == request_id and "method" not in message:
                    if "error" in message:
                        raise RuntimeError(message["error"].get("message"))
                    return message.get("result", {})
                self._pending.append(message)

    # Call a compiler tool and collect its text and error status.
    def call_tool(self, name, arguments):
        result = self.request("tools/call", {
            "name": name,
            "arguments": arguments,
        })
        text = "\n".join(c.get("text", "") for c in result.get("content", [])
                         if c.get("type") == "text")
        return text, bool(result.get("isError"))


class ReplayBackend:
    """Replay recorded compiler tool calls without contacting a model.

    Tasks must match their recorded context, instructions, prompt, and effective
    policy. Each tool call is checked again by the current compiler.
    """

    # Group recorded generation, tool, and outcome events by task.
    def __init__(self, path):
        self.tasks = []
        self.process = None
        with open(path, encoding="utf-8") as stream:
            for line in stream:
                event = json.loads(line)
                if event["event"] == "generation":
                    self.tasks.append({
                        "task": event["data"],
                        "tools": [],
                    })
                elif event["event"] == "tool" and self.tasks:
                    self.tasks[-1]["tools"].append(event["data"])
                elif event["event"] == "outcome" and self.tasks:
                    self.tasks[-1]["outcome"] = event["data"]

    # Replay only a matching task and stop after its accepted submission.
    def generate(self, conn, tools, task):
        fields = ("name", "signature", "prompt", "system_prompt", "generation", "context_digest")
        for recording in reversed(self.tasks):
            if not all(task.get(field) == recording["task"].get(field) for field in fields):
                continue
            if task.get("references", []) != recording["task"].get("references", []):
                continue
            outcome = recording.get("outcome", {})
            if outcome.get("status") != "ok":
                continue
            for event in recording["tools"]:
                text, is_error = conn.call_tool(event["name"], event["arguments"])
                if event["name"] == "submit" and not is_error:
                    return {
                        "status": "ok",
                        "model": outcome.get("model", "replay"),
                    }
            raise RuntimeError("recorded submission was not accepted during replay")
        raise RuntimeError("no matching successful task in transcript")


class AnthropicBackend:
    """A tool-use loop against the Messages API (no SDK needed)."""

    # Resolve credentials, endpoint, and model defaults for this task.
    def __init__(self, config=None):
        config = config or {}
        self.api_key = config.get("api_key") or os.environ["ANTHROPIC_API_KEY"]
        self.model = os.environ.get("LLMCPP_MODEL") or "claude-opus-5"
        self.base_url = (config.get("base_url") or os.environ.get(
            "ANTHROPIC_BASE_URL", "https://api.anthropic.com")).rstrip("/")
        self.process = None

    # Return the configured model identifier.
    def model_id(self):
        return self.model

    # Send a Messages API request and retry transient failures.
    def post(self, body):
        data = json.dumps(body).encode()
        for attempt in range(6):
            request = urllib.request.Request(
                self.base_url + "/v1/messages", data=data,
                headers={
                    "x-api-key": self.api_key,
                    "anthropic-version": "2023-06-01",
                    "content-type": "application/json",
                },
            )
            try:
                with urllib.request.urlopen(request, timeout=600) as response:
                    return json.loads(response.read())
            except urllib.error.HTTPError as e:
                detail = e.read().decode(errors="replace")
                if e.code in (429, 500, 502, 503, 504, 529) and attempt < 5:
                    delay = min(60, 2 ** (attempt + 1))
                    log("HTTP %d, retrying in %ds" % (e.code, delay))
                    time.sleep(delay)
                    continue
                raise RuntimeError("Anthropic API error %d: %s"
                                   % (e.code, detail[:500]))
            except urllib.error.URLError as e:
                if attempt < 5:
                    time.sleep(2 ** (attempt + 1))
                    continue
                raise RuntimeError("cannot reach the Anthropic API: %s"
                                   % e.reason)

    # Exchange model tool calls until the compiler accepts a body.
    def generate(self, conn, tools, task):
        limits = task.get("limits", {})
        max_turns = int(limits.get("max_tool_calls", 60)) + 5
        api_tools = [
            {
                "name": tool["name"],
                "description": tool.get("description", ""),
                "input_schema": tool.get("inputSchema", {"type": "object"}),
            }
            for tool in tools
        ]
        messages = [{
            "role": "user",
            "content": task_message(task),
        }]
        model = self.model
        for _ in range(max_turns):
            response = self.post({
                "model": self.model,
                "max_tokens": int(limits.get("max_output_tokens") or 16000),
                "system": task["system_prompt"],
                "tools": api_tools,
                "messages": messages,
            })
            model = response.get("model", model)
            content = response.get("content", [])
            messages.append({
                "role": "assistant",
                "content": content,
            })
            uses = [b for b in content if b.get("type") == "tool_use"]
            if not uses:
                break
            results, accepted = [], False
            for use in uses:
                text, is_error = conn.call_tool(use["name"],
                                                use.get("input") or {})
                log(use["name"], "->", (text.splitlines() or [""])[0])
                accepted |= use["name"] == "submit" and not is_error
                results.append({
                    "type": "tool_result",
                    "tool_use_id": use["id"],
                    "content": text or "(empty)",
                    "is_error": is_error,
                })
            messages.append({
                "role": "user",
                "content": results,
            })
            if accepted:
                return {
                    "status": "ok",
                    "model": model,
                }
        return {
            "status": "error",
            "model": model,
            "message": "the model stopped without an accepted submit",
        }


class OpenAIBackend:
    """Generate bodies through the Responses API and compiler tools."""

    # Resolve credentials and the Responses API endpoint once per task.
    def __init__(self, config=None):
        config = config or {}
        self.api_key = config.get("api_key") or os.environ["OPENAI_API_KEY"]
        self.model = os.environ.get("LLMCPP_MODEL") or "gpt-6-astra"
        self.base_url = (config.get("base_url") or os.environ.get(
            "OPENAI_BASE_URL", "https://api.openai.com")).rstrip("/")
        if not self.base_url.endswith("/v1"):
            self.base_url += "/v1"
        self.process = None

    # Return the requested model until the API reports its actual model.
    def model_id(self):
        return self.model

    # Retry transient failures within the generation deadline.
    def post(self, body, deadline):
        for attempt in range(6):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("OpenAI generation deadline reached")
            request = urllib.request.Request(
                self.base_url + "/responses",
                data=json.dumps(body).encode(),
                headers={
                    "Authorization": "Bearer " + self.api_key,
                    "Content-Type": "application/json",
                },
            )
            try:
                with urllib.request.urlopen(request, timeout=remaining) as response:
                    return json.load(response)
            except urllib.error.HTTPError as error:
                detail = error.read().decode(errors="replace")
                if error.code not in (429, 500, 502, 503, 504) or attempt == 5:
                    raise RuntimeError("OpenAI API error %d: %s" % (error.code, detail[:500]))
            except urllib.error.URLError as error:
                if attempt == 5:
                    raise RuntimeError("cannot reach the OpenAI API: %s" % error.reason)
            delay = min(60, 2 ** (attempt + 1), max(0, deadline - time.monotonic()))
            time.sleep(delay)

    # Continue tool calls until the compiler accepts a submitted body.
    def generate(self, conn, tools, task):
        limits = task.get("limits", {})
        deadline = time.monotonic() + int(limits.get("timeout_seconds", 600))
        api_tools = [
            {
                "type": "function",
                "name": tool["name"],
                "description": tool.get("description", ""),
                "parameters": tool.get("inputSchema", {"type": "object"}),
                "strict": False,
            }
            for tool in tools
        ]
        inputs = task_message(task)
        previous_id = None
        model = self.model
        for _ in range(int(limits.get("max_tool_calls", 60)) + 5):
            body = {
                "model": self.model,
                "instructions": task["system_prompt"],
                "tools": api_tools,
                "input": inputs,
                "max_output_tokens": int(limits.get("max_output_tokens") or 16000),
            }
            if previous_id:
                body["previous_response_id"] = previous_id
            response = self.post(body, deadline)
            previous_id = response["id"]
            model = response.get("model", model)
            calls = [item for item in response["output"] if item.get("type") == "function_call"]
            if not calls:
                break
            inputs = []
            for call in calls:
                arguments = json.loads(call.get("arguments", "{}"))
                if isinstance(arguments, dict):
                    text, is_error = conn.call_tool(call["name"], arguments)
                else:
                    text, is_error = "function arguments were not a JSON object", True
                log(call["name"], "->", (text.splitlines() or [""])[0])
                if call["name"] == "submit" and not is_error:
                    return {"status": "ok", "model": model}
                inputs.append({
                    "type": "function_call_output",
                    "call_id": call["call_id"],
                    "output": ("[error] " if is_error else "") + (text or "(empty)"),
                })
        return {
            "status": "error",
            "model": model,
            "message": "the model stopped without an accepted submit",
        }


class CodexBackend:
    """Codex CLI adapter with llmc++'s tools exposed as an MCP server."""

    # Store the CLI executable and generation defaults.
    def __init__(self, codex):
        self.codex = codex
        self.model = os.environ.get("LLMCPP_MODEL")
        self.effort = os.environ.get("LLMCPP_EFFORT", "medium")
        self.process = None

    # Return the requested model or the backend label.
    def model_id(self):
        return self.model or "codex"

    # Run Codex with a temporary compiler-tool bridge and enforce its deadline.
    def generate(self, conn, tools, task):
        if task.get("limits", {}).get("max_output_tokens"):
            raise RuntimeError("codex backend cannot enforce max_output_tokens; use an API backend")
        timeout = int(task.get("limits", {}).get("timeout_seconds", 600))
        state = {"accepted": False}
        with tempfile.TemporaryDirectory(prefix="llmcpp-agent-") as tmp:
            socket_path = os.path.join(tmp, "tools.sock")
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(socket_path)
            server.listen(4)
            threading.Thread(target=serve_mcp,
                             args=(server, conn, tools, state),
                             daemon=True).start()

            bridge_args = [os.path.abspath(__file__), "--mcp-bridge",
                           socket_path]
            command = [
                self.codex, "exec", "--json", "--ephemeral",
                "--ignore-user-config", "--ignore-rules",
                "--skip-git-repo-check", "--sandbox", "read-only",
                "--cd", tmp,
                "--config", 'approval_policy="never"',
                "--config", "mcp_servers.llmcpp.command=%s"
                            % json.dumps(sys.executable),
                "--config", "mcp_servers.llmcpp.args=%s"
                            % json.dumps(bridge_args),
                "--config", 'mcp_servers.llmcpp.default_tools_approval_mode="approve"',
                "--config", "mcp_servers.llmcpp.required=true",
            ]
            if self.model:
                command += ["--model", self.model]
            if self.effort:
                command += ["--config", "model_reasoning_effort=%s"
                                        % json.dumps(self.effort)]
            command.append(task["system_prompt"] + "\n\n" + task_message(task))

            log("running codex exec for", task.get("name"))
            self.process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, cwd=tmp, text=True)
            try:
                out, err = self.process.communicate(timeout=timeout)
                timed_out = False
            except subprocess.TimeoutExpired:
                self.process.kill()
                out, err = self.process.communicate()
                timed_out = True
            code = self.process.returncode
            self.process = None
            server.close()

        message = ""
        for line in out.splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            item = event.get("item") or {}
            if (event.get("type") == "item.completed"
                    and item.get("type") == "agent_message"):
                message = item.get("text") or message
            if event.get("type") in ("error", "turn.failed"):
                message = (event.get("message")
                           or (event.get("error") or {}).get("message")
                           or message)
        if timed_out:
            message = "codex timed out after %ds" % timeout
        if state["accepted"]:
            return {
                "status": "ok",
                "model": self.model_id(),
                "message": message,
            }
        return {
            "status": "error",
            "model": self.model_id(),
            "message": (
                message or (err or "").strip()[-1000:]
                or "codex exited with status %s without an accepted submit" % code
            ),
        }


class ClaudeCodeBackend:
    """Claude Code CLI adapter with llmc++'s tools exposed as an MCP server.

    Claude Code starts `llmcpp-agent --mcp-bridge <socket>` as the MCP server.
    The bridge connects back to this process, which forwards tools/call to
    llmc++ over the original stdio connection.
    """

    # Store the CLI executable and generation defaults.
    def __init__(self, claude):
        self.claude = claude
        self.model = os.environ.get("LLMCPP_MODEL")
        self.effort = os.environ.get("LLMCPP_EFFORT", "medium")
        self.process = None

    # Return the requested model or the backend label.
    def model_id(self):
        return self.model or "claude"

    # Run Claude Code with a temporary compiler-tool bridge and enforce its deadline.
    def generate(self, conn, tools, task):
        if task.get("limits", {}).get("max_output_tokens"):
            raise RuntimeError("claude backend cannot enforce max_output_tokens; use an API backend")
        timeout = int(task.get("limits", {}).get("timeout_seconds", 600))
        state = {"accepted": False}
        with tempfile.TemporaryDirectory(prefix="llmcpp-agent-") as tmp:
            socket_path = os.path.join(tmp, "tools.sock")
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(socket_path)
            server.listen(4)
            threading.Thread(target=serve_mcp,
                             args=(server, conn, tools, state),
                             daemon=True).start()

            config_path = os.path.join(tmp, "mcp.json")
            with open(config_path, "w") as f:
                json.dump({
                    "mcpServers": {
                        "llmcpp": {
                            "type": "stdio",
                            "command": sys.executable,
                            "args": [
                                os.path.abspath(__file__),
                                "--mcp-bridge",
                                socket_path,
                            ],
                        },
                    },
                }, f, indent=4)

            command = [self.claude, "-p", task_message(task),
                       "--mcp-config", config_path, "--strict-mcp-config",
                       "--tools", "",
                       "--allowedTools",
                       ",".join("mcp__llmcpp__" + t["name"] for t in tools),
                       "--system-prompt", task["system_prompt"],
                       "--output-format", "json",
                       "--no-session-persistence",
                       "--disable-slash-commands"]
            if self.model:
                command += ["--model", self.model]
            if self.effort:
                command += ["--effort", self.effort]

            log("running claude -p for", task.get("name"))
            self.process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, cwd=tmp, text=True)
            try:
                out, err = self.process.communicate(timeout=timeout)
                timed_out = False
            except subprocess.TimeoutExpired:
                self.process.kill()
                out, err = self.process.communicate()
                timed_out = True
            code = self.process.returncode
            self.process = None
            server.close()

        model, message = self.model_id(), ""
        try:
            result = json.loads(out)
            message = result.get("result") or ""
            usage = result.get("modelUsage") or {}
            if usage:
                model = max(usage, key=lambda m: usage[m].get("outputTokens", 0))
            if result.get("is_error"):
                message = "claude: " + (message or result.get("subtype", "error"))
        except ValueError:
            message = (err or out or "").strip()[-1000:]
        if timed_out:
            message = "claude timed out after %ds" % timeout
        if state["accepted"]:
            return {
                "status": "ok",
                "model": model,
                "message": message,
            }
        return {
            "status": "error",
            "model": model,
            "message": message or "claude exited with status %s without an accepted submit" % code,
        }


# Bridge the CLI backend's standard streams to the agent socket.
def mcp_bridge(socket_path):
    """Bidirectional transport between CLI MCP stdio and the agent socket."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(socket_path)

    # Forward standard input and close the socket's write side at end of input.
    def upstream():
        try:
            while True:
                data = sys.stdin.buffer.read1(65536)
                if not data:
                    break
                sock.sendall(data)
        finally:
            try:
                sock.shutdown(socket.SHUT_WR)
            except OSError:
                pass

    threading.Thread(target=upstream, daemon=True).start()
    while True:
        data = sock.recv(65536)
        if not data:
            break
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


# Dispatch each CLI MCP connection to its own worker.
def serve_mcp(server, conn, tools, state):
    """Threaded MCP listener for CLI backends."""
    while True:
        try:
            client, _ = server.accept()
        except OSError:
            return
        threading.Thread(target=handle_mcp,
                         args=(client, conn, tools, state),
                         daemon=True).start()


# Route MCP requests to compiler tools and track accepted submissions.
def handle_mcp(client, conn, tools, state):
    """MCP request handling for one CLI connection.

    Notifications need no reply. Compiler transport failures become tool errors
    so the CLI backend receives a response even when the compiler disconnects.
    """
    with client, client.makefile("rwb") as stream:
        for line in stream:
            if not line.strip():
                continue
            message = json.loads(line)
            if "id" not in message:
                continue
            method = message.get("method")
            params = message.get("params") or {}
            response = {
                "jsonrpc": "2.0",
                "id": message["id"],
            }
            if method == "initialize":
                response["result"] = {
                    "protocolVersion": params.get("protocolVersion",
                                                  "2025-06-18"),
                    "capabilities": {"tools": {}},
                    "serverInfo": {
                        "name": "llmcpp",
                        "version": VERSION,
                    },
                }
            elif method == "tools/list":
                response["result"] = {"tools": tools}
            elif method == "tools/call":
                try:
                    result = conn.request("tools/call", params)
                except Exception as e:
                    result = {
                        "content": [{
                            "type": "text",
                            "text": "llmc++ error: %s" % e,
                        }],
                        "isError": True,
                    }
                log(params.get("name"), "->",
                    "error" if result.get("isError") else "ok")
                if params.get("name") == "submit" and not result.get("isError"):
                    state["accepted"] = True
                response["result"] = result
            elif method == "ping":
                response["result"] = {}
            else:
                response["error"] = {
                    "code": -32601,
                    "message": "method not found: %s" % method,
                }
            stream.write((json.dumps(response) + "\n").encode())
            stream.flush()


# Validate the explicit backend selection and resolve its configuration.
def choose_backend(config=None):
    config = config or {}
    choice = os.environ.get("LLMCPP_BACKEND")
    if not choice:
        raise RuntimeError("select a backend with LLMCPP_BACKEND or llmc++ -fllm-backend")
    if choice == "anthropic":
        if not (config.get("api_key") or os.environ.get("ANTHROPIC_API_KEY")):
            raise RuntimeError("LLMCPP_BACKEND=anthropic needs ANTHROPIC_API_KEY")
        return AnthropicBackend(config)
    if choice == "openai":
        if not (config.get("api_key") or os.environ.get("OPENAI_API_KEY")):
            raise RuntimeError("LLMCPP_BACKEND=openai needs OPENAI_API_KEY")
        return OpenAIBackend(config)
    if choice == "codex":
        codex = shutil.which(config.get("executable") or os.environ.get("LLMCPP_CODEX", "codex"))
        if codex:
            return CodexBackend(codex)
        raise RuntimeError("LLMCPP_BACKEND=codex needs the Codex CLI")
    if choice == "claude":
        claude = shutil.which(config.get("executable") or os.environ.get("LLMCPP_CLAUDE", "claude"))
        if not claude:
            raise RuntimeError("LLMCPP_BACKEND=claude needs the Claude Code CLI")
        return ClaudeCodeBackend(claude)
    raise RuntimeError("unknown LLMCPP_BACKEND '%s'" % choice)


# Select the execution mode and serve compiler generation requests.
def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--mcp-bridge":
        mcp_bridge(sys.argv[2])
        return 0

    backend = None
    replay = ReplayBackend(sys.argv[2]) if len(sys.argv) == 3 and sys.argv[1] == "--replay" else None

    # Stop the active backend process before exiting on termination.
    def on_term(signum, frame):
        if backend is not None and backend.process is not None:
            backend.process.kill()
        sys.exit(1)

    signal.signal(signal.SIGTERM, on_term)

    conn = Connection()
    conn.request("initialize", {
        "protocolVersion": "2025-06-18",
        "capabilities": {},
        "clientInfo": {
            "name": "llmcpp-agent",
            "version": VERSION,
            "model": "",
        },
    })
    tools = conn.request("tools/list", {}).get("tools", [])
    conn.send({
        "jsonrpc": "2.0",
        "method": "notifications/initialized",
    })

    while True:
        message = conn.next_message()
        if message is None:
            return 0
        if "id" not in message:
            continue
        if message.get("method") != "llm/generate":
            conn.send({
                "jsonrpc": "2.0",
                "id": message["id"],
                "error": {
                    "code": -32601,
                    "message": "method not found",
                },
            })
            continue
        try:
            task = message.get("params") or {}
            if task.get("protocol_version") != 1:
                raise RuntimeError("unsupported llmcpp protocol version")
            config = task.get("agent_config") or {}
            backend = replay or choose_backend(config)
            if not replay:
                backend.model = (
                    task.get("generation", {}).get("model")
                    or config.get("model")
                    or backend.model
                )
            if hasattr(backend, "effort"):
                backend.effort = config.get("effort", backend.effort)
            result = backend.generate(conn, tools, task)
        except Exception as e:
            result = {
                "status": "error",
                "message": "%s: %s" % (type(e).__name__, e),
            }
        conn.send({
            "jsonrpc": "2.0",
            "id": message["id"],
            "result": result,
        })


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (EOFError, BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
